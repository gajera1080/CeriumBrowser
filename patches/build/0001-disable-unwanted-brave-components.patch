From 1e9ae2844c3925f9df80f6ceced5daad201da4c0 Mon Sep 17 00:00:00 2001
From: Braving CI <ci@braving.org>
Date: Sat, 5 Sep 2026 11:16:43 +0530
Subject: [PATCH] [build] Disable unwanted Brave components and telemetry in
 android_defaults.gni

---
 build/args/android_defaults.gni | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/build/args/android_defaults.gni b/build/args/android_defaults.gni
index bc218ce..c7230a0 100644
--- a/build/args/android_defaults.gni
+++ b/build/args/android_defaults.gni
@@ -14,3 +14,20 @@ enable_mdns = true
 
 # We want it to be enabled for all configurations
 disable_android_lint = false
+
+# Braving minimal & privacy defaults for Android
+# Bloat removal
+enable_brave_wallet = false
+enable_brave_vpn_v1 = false
+enable_brave_vpn_v2 = false
+enable_brave_vpn = false
+enable_ai_chat = false
+enable_brave_news = false
+enable_brave_rewards = false
+enable_brave_ads = false
+enable_brave_talk = false
+
+# Telemetry removal
+enable_brave_stats_updater = false
+enable_web_discovery = false
+enable_web_discovery_native = false
-- 
2.55.0

