From: gajgaje2000 <gajgaje2000@gmail.com>
Date: Sun, 27 Sep 2026 11:40:00 +0000
Subject: [PATCH] [debloat] Enforce mandatory debloat and privacy enterprise policies

Loads mandatory browser and feature policies immediately during
BraveBrowserPolicyProvider::Init() and enforces MetricsReportingEnabled=false,
BraveP3AEnabled=false, and BraveStatsPingEnabled=false alongside feature
disabling policies. This suppresses First Run data-collection onboarding steps
and removes all telemetry/reporting toggles from Brave Shields & privacy.
---
diff --git a/components/brave_policy/brave_browser_policy_provider.cc b/components/brave_policy/brave_browser_policy_provider.cc
--- a/components/brave_policy/brave_browser_policy_provider.cc
+++ b/components/brave_policy/brave_browser_policy_provider.cc
@@ -31,6 +31,7 @@ void BraveBrowserPolicyProvider::Init(policy::SchemaRegistry* registry) {
   // loading.
   policy_manager_observation_.Observe(
       brave_origin::BraveOriginPolicyManager::GetInstance());
+  RefreshPolicies(policy::PolicyFetchReason::kBrowserStart);
 }
 
 void BraveBrowserPolicyProvider::RefreshPolicies(
@@ -62,6 +63,30 @@ void BraveBrowserPolicyProvider::OnBrowserPolicyChanged(
 policy::PolicyBundle BraveBrowserPolicyProvider::LoadPolicies() {
   policy::PolicyBundle bundle;
 
+  // Braving: Enforce debloat and privacy policies via Enterprise Policy
+  policy::PolicyMap& pm = bundle.Get(policy::PolicyNamespace(policy::POLICY_DOMAIN_CHROME, std::string()));
+  auto enforce = [&](const char* name, bool val) {
+    pm.Set(name, policy::POLICY_LEVEL_MANDATORY, policy::POLICY_SCOPE_USER, policy::POLICY_SOURCE_PLATFORM, base::Value(val), nullptr);
+  };
+  enforce("MetricsReportingEnabled", false);
+  enforce("BraveWalletDisabled", true);
+  enforce("BraveVPNDisabled", true);
+  enforce("BraveAIChatEnabled", false);
+  enforce("BraveNewsDisabled", true);
+  enforce("BraveRewardsDisabled", true);
+  enforce("BraveSearchResultAdsEnabled", false);
+  enforce("BraveTalkDisabled", true);
+  enforce("BraveStatsPingEnabled", false);
+  enforce("BraveWebDiscoveryEnabled", false);
+  enforce("BraveP3AEnabled", false);
+  enforce("BraveWaybackMachineEnabled", false);
+  enforce("BraveLocalAIEnabled", false);
+  enforce("IPFSEnabled", false);
+  enforce("TorDisabled", true);
+  enforce("BravePlaylistEnabled", false);
+  enforce("EmailAliasesEnabled", false);
+  enforce("PsstEnabled", false);
+
   if (brave_origin::IsBraveOriginPurchased()) {
     LoadBraveOriginPolicies(bundle);
   }
