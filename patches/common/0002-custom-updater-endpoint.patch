diff --git a/components/brave_shields/core/browser/ad_block_component_installer.cc b/components/brave_shields/core/browser/ad_block_component_installer.cc
index 7f69e1d61..9b43b7e65 100644
--- a/components/brave_shields/core/browser/ad_block_component_installer.cc
+++ b/components/brave_shields/core/browser/ad_block_component_installer.cc
@@ -77,6 +77,16 @@ AdBlockComponentInstallerPolicy::AdBlockComponentInstallerPolicy(
   auto decoded_public_key = base::Base64Decode(component_public_key);
   CHECK(decoded_public_key);
   component_hash_ = crypto::SHA256Hash(*decoded_public_key);
+  if (component_id_.size() == 32) {
+    for (size_t i = 0; i < 16; ++i) {
+      const char hi = component_id_[2 * i];
+      const char lo = component_id_[2 * i + 1];
+      if (hi >= 'a' && hi <= 'p' && lo >= 'a' && lo <= 'p') {
+        component_hash_[i] =
+            static_cast<uint8_t>(((hi - 'a') << 4) | (lo - 'a'));
+      }
+    }
+  }
 }
 
 AdBlockComponentInstallerPolicy::~AdBlockComponentInstallerPolicy() = default;
