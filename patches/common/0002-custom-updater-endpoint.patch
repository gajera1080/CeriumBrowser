+bool AdBlockComponentFiltersProvider::IsPrimaryDefaultProvider() const {
+  if (engine_is_default_) {
+    return component_id_ == "iodkpdagapdfkphljnddpjlldadblomo";
+  }
+  return component_id_ == "cdbbhgbmjhfnhnmgeddbliobbofkgdhe";
+}
+
 
 base::FilePath AdBlockComponentFiltersProvider::GetFilterSetPath() {
   if (component_path_.empty()) {
@@ -151,7 +158,18 @@ void AdBlockComponentFiltersProvider::LoadFilterSet(
 
   base::ThreadPool::PostTaskAndReplyWithResult(
       FROM_HERE, {base::MayBlock()},
-      base::BindOnce(&brave_component_updater::ReadDATFileData, list_file_path),
+      base::BindOnce(
+          [](const base::FilePath& path) {
+            if (!base::PathExists(path)) {
+              base::FilePath dat_path =
+                  path.DirName().AppendASCII("rs-ABPFilterParserData.dat");
+              if (base::PathExists(dat_path)) {
+                return brave_component_updater::ReadDATFileData(dat_path);
+              }
+            }
+            return brave_component_updater::ReadDATFileData(path);
+          },
+          list_file_path),
       base::BindOnce(&OnReadDATFileData, std::move(cb), permission_mask_,
                      flow));
 }
