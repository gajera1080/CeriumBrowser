+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+#include "components/update_client/net/network_impl.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/weak_ptr.h"
+#include "base/numerics/safe_conversions.h"
+#include "build/branding_buildflags.h"
+#include "components/update_client/net/network_chromium.h"
+#include "net/base/load_flags.h"
+#include "net/http/http_response_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/is_potentially_trustworthy.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+
+namespace {
+
+bool IsStaticUpdaterGetUrl(const GURL& url) {
+  return url.DomainIs("braving.gitlab.io") || url.DomainIs("gitlab.io") || url.DomainIs("updates.braving.org");
+}
+
+}  // namespace
+
+#define LOAD_DISABLE_CACHE                  \
+  LOAD_DISABLE_CACHE;                       \
+  if (resource_request->method == "POST" && \
+      IsStaticUpdaterGetUrl(url)) {         \
+    resource_request->method = "GET";       \
+  }
+
+#define AttachStringForUpload(post_data, content_type) \
+  SetAllowPartialResults(false);                       \
+  if (!IsStaticUpdaterGetUrl(url))                     \
+    simple_url_loader->AttachStringForUpload(post_data, content_type)
+
+#include <components/update_client/net/network_impl.cc>
+
+#undef AttachStringForUpload
+#undef LOAD_DISABLE_CACHE
diff --git a/chromium_src/components/update_client/update_checker.cc b/chromium_src/components/update_client/update_checker.cc
index 4806e338a..87532fdd2 100644
--- a/chromium_src/components/update_client/update_checker.cc
+++ b/chromium_src/components/update_client/update_checker.cc
@@ -79,12 +79,9 @@ void SequentialUpdateChecker::CheckNext() {
   DCHECK(update_context_);
 
   // Support multiple checks in a single call, but only if they are all Brave.
+  // Braving: Batch all components into a single static manifest request.
   std::vector<std::string> ids;
   for (auto id_it = remaining_ids_.begin(); id_it != remaining_ids_.end();) {
-    const auto& component = update_context_->components[*id_it];
-    if (!ids.empty() && !IsBraveComponent(component.get())) {
-      break;
-    }
     ids.push_back(*id_it);
     id_it = remaining_ids_.erase(id_it);
   }
@@ -132,13 +129,46 @@ void SequentialUpdateChecker::UpdateResultAvailable(
     // practice during development, it has sometimes happened that the list was
     // empty. A for loop is an easy way to guard against such unexpected cases:
     for (const auto& result : results->apps) {
-      results_.apps.push_back(result);
+      ProtocolParser::App adjusted = result;
+      if (adjusted.status == "update") {
+        adjusted.status = "ok";
+      }
+      auto comp_it = update_context_->components.find(adjusted.app_id);
+      if (comp_it != update_context_->components.end() && comp_it->second) {
+        const auto& crx_comp = comp_it->second->crx_component();
+        if (crx_comp && adjusted.status == "ok") {
+          if (!adjusted.nextversion.IsValid() ||
+              (crx_comp->version.IsValid() &&
+               (adjusted.nextversion.CompareTo(crx_comp->version) < 0 ||
+                (adjusted.nextversion.CompareTo(crx_comp->version) == 0 &&
+                 !crx_comp->same_version_update_allowed)))) {
+            adjusted.status = "noupdate";
+            adjusted.pipelines.clear();
+          }
+        }
+      }
+      results_.apps.push_back(std::move(adjusted));
     }
   }
 
   bool done = error || remaining_ids_.empty();
 
   if (done) {
+    if (!error && update_context_) {
+      for (const auto& checked_id :
+           update_context_->components_to_check_for_updates) {
+        const bool found = std::ranges::any_of(
+            results_.apps, [&](const ProtocolParser::App& app) {
+              return app.app_id == checked_id;
+            });
+        if (!found) {
+          ProtocolParser::App stub;
+          stub.app_id = checked_id;
+          stub.status = "noupdate";
+          results_.apps.push_back(std::move(stub));
+        }
+      }
+    }
     base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
         FROM_HERE,
         base::BindOnce(
