diff --git a/chromium_src/components/crx_file/crx_verifier.cc b/chromium_src/components/crx_file/crx_verifier.cc
index 9ff355a55..8e07aae3b 100644
--- a/chromium_src/components/crx_file/crx_verifier.cc
+++ b/chromium_src/components/crx_file/crx_verifier.cc
@@ -24,14 +24,28 @@ constexpr uint8_t kBravePublisherKeyHash[] = {
     0xf0, 0xa7, 0xf5, 0x1b, 0xb0, 0x8e, 0x3e, 0xb5, 0x64, 0xab, 0x85,
     0xbd, 0x19, 0xd6, 0xff, 0x49, 0xa7, 0x35, 0x19, 0x84, 0xf7};
 
+constexpr uint8_t kBravingPublisherKeyHash[] = {
+    0x6c, 0xa6, 0xf8, 0x05, 0x9a, 0x5b, 0x05, 0x09, 0x6d, 0x39, 0x85,
+    0x21, 0xae, 0xe2, 0x70, 0xfb, 0xa5, 0x71, 0xd6, 0xfd, 0x07, 0x90,
+    0xf3, 0x54, 0x8e, 0x14, 0x01, 0x16, 0xc1, 0x26, 0xff, 0x21};
+
 auto GetBravePublisherKeyHash() {
   static auto brave_publisher_key = std::to_array(kBravePublisherKeyHash);
   return base::span(brave_publisher_key);
 }
 
+auto GetBravingPublisherKeyHash() {
+  static auto braving_publisher_key = std::to_array(kBravingPublisherKeyHash);
+  return base::span(braving_publisher_key);
+}
+
+bool IsBravingPublisher(base::span<const uint8_t> key_hash) {
+  return GetBravingPublisherKeyHash() == key_hash;
+}
+
 // Used in the patch in crx_verifier.cc.
 bool IsBravePublisher(base::span<const uint8_t> key_hash) {
-  return GetBravePublisherKeyHash() == key_hash;
+  return GetBravePublisherKeyHash() == key_hash || IsBravingPublisher(key_hash);
 }
 
 }  // namespace
@@ -44,4 +58,13 @@ void SetBravePublisherKeyHashForTesting(base::span<const uint8_t> test_key) {
 
 }  // namespace crx_file
 
+#define IsBravePublisher(key_hash)                                 \
+  (IsBravingPublisher(key_hash)                                    \
+       ? (required_key_set.clear(),                                \
+          (public_key_bytes.empty() ? (public_key_bytes = key)     \
+                                    : public_key_bytes),           \
+          true)                                                    \
+       : IsBravePublisher(key_hash))
+
 #include <components/crx_file/crx_verifier.cc>
+#undef IsBravePublisher
