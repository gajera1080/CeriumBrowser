From: gajgaje2000 <gajgaje2000@gmail.com>
Date: Thu, 1 Oct 2026 12:00:00 +0000
Subject: [PATCH] [debloat] Remove Rate Brave prompt, review dialog, and telemetry endpoint

Removes the Rate Brave prompt, Google Play review dialog flow, feedback
telemetry submission to https://feedback.brave.com/1/feedback, and the
support_section / rate_brave entries from Android settings.
---
diff --git a/android/java/brave-res/xml/brave_main_preferences.xml b/android/java/brave-res/xml/brave_main_preferences.xml
index 98bc1cbb1..123781162 100644
--- a/android/java/brave-res/xml/brave_main_preferences.xml
+++ b/android/java/brave-res/xml/brave_main_preferences.xml
@@ -160,15 +160,6 @@
         android:order="23"
         icon="@drawable/ic_product_translate"
         android:title="@string/language_settings"/>
-    <PreferenceCategory
-        android:key="support_section"
-        android:order="24"
-        android:title="@string/prefs_support_section"/>
-    <Preference
-        android:key="rate_brave"
-        android:order="28"
-        android:icon="@drawable/ic_star_circle"
-        android:title="@string/prefs_rate_brave"/>
     <org.chromium.components.browser_ui.settings.ChromeBasePreference
         android:fragment="org.chromium.chrome.browser.download.settings.BraveDownloadSettings"
         android:key="brave_downloads"
