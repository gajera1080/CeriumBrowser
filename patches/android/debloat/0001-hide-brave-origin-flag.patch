From: Braving Authors <support@braving.org>
Date: Sun, 27 Sep 2026 11:40:00 +0000
Subject: [PATCH] [debloat] Disable kBraveOrigin feature flag by default

Hides the Brave Origin menu entry in Settings by default while still allowing
advanced users to reveal it via brave://flags/#brave-origin.
---
diff --git a/components/brave_origin/features.cc b/components/brave_origin/features.cc
--- a/components/brave_origin/features.cc
+++ b/components/brave_origin/features.cc
@@ -10,5 +10,5 @@
 namespace brave_origin::features {
 
-BASE_FEATURE(kBraveOrigin, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kBraveOrigin, base::FEATURE_DISABLED_BY_DEFAULT);
 
 }  // namespace brave_origin::features
