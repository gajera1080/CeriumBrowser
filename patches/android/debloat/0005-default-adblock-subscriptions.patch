From: Braving Authors <support@braving.org>
Date: Sun, 27 Sep 2026 11:40:00 +0000
Subject: [PATCH] [debloat] Pre-seed direct uBlock Origin and EasyList subscriptions

Unblocks ComponentProvidersGate without waiting for the Brave catalog CRX and
registers default filter list subscriptions (EasyList, EasyPrivacy, uBlock
Origin filters, Peter Lowe's list) so they download automatically on launch.
---
diff --git a/components/brave_shields/content/browser/ad_block_service.cc b/components/brave_shields/content/browser/ad_block_service.cc
--- a/components/brave_shields/content/browser/ad_block_service.cc
+++ b/components/brave_shields/content/browser/ad_block_service.cc
@@ -4,6 +4,7 @@
 // You can obtain one at https://mozilla.org/MPL/2.0/.
 
 #include "brave/components/brave_shields/content/browser/ad_block_service.h"
+#include "base/values.h"
 
 #include <memory>
 #include <optional>
@@ -266,6 +267,8 @@ AdBlockService::AdBlockService(
       std::make_unique<SourceProviderObserver>(
           make_on_resources_loaded_callback, resource_provider_.get(),
           filters_provider_manager_.get(), false, debug_mode, task_runner_);
+  // Braving: Unblock ComponentProvidersGate without waiting for Brave catalog CRX
+  component_service_manager_->SetFilterListCatalog({});
 }
 
 AdBlockService::~AdBlockService() = default;
@@ -446,7 +449,24 @@ void RegisterPrefsForAdBlockService(PrefRegistrySimple* registry) {
       prefs::kAdBlockMobileNotificationsListSettingTouched, false);
   registry->RegisterStringPref(prefs::kAdBlockCustomFilters, std::string());
   registry->RegisterDictionaryPref(prefs::kAdBlockRegionalFilters);
-  registry->RegisterDictionaryPref(prefs::kAdBlockListSubscriptions);
+  // Braving: Pre-seed direct uBlock Origin & EasyList subscription sources
+  base::DictValue default_subscriptions;
+  auto add_sub = [&](const char* url, const char* title) {
+    base::DictValue sub;
+    sub.Set("enabled", true);
+    sub.Set("last_update_attempt", "0");
+    sub.Set("last_successful_update_attempt", "0");
+    sub.Set("expires", 72);
+    sub.Set("title", title);
+    default_subscriptions.Set(url, std::move(sub));
+  };
+  add_sub("https://easylist.to/easylist/easylist.txt", "EasyList");
+  add_sub("https://easylist.to/easylist/easyprivacy.txt", "EasyPrivacy");
+  add_sub("https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/filters.txt", "uBlock filters");
+  add_sub("https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/badware.txt", "uBlock filters - Badware risks");
+  add_sub("https://pgl.yoyo.org/adservers/serverlist.php?hostformat=adblockplus&showintro=1&mimetype=plaintext", "Peter Lowe's list");
+
+  registry->RegisterDictionaryPref(prefs::kAdBlockListSubscriptions, std::move(default_subscriptions));
   registry->RegisterBooleanPref(prefs::kAdBlockCheckedDefaultRegion, false);
   registry->RegisterBooleanPref(prefs::kAdBlockCheckedAllDefaultRegions, false);
   registry->RegisterBooleanPref(prefs::kAdBlockOnlyModeEnabled, false);
diff --git a/components/brave_shields/content/browser/ad_block_subscription_service_manager.cc b/components/brave_shields/content/browser/ad_block_subscription_service_manager.cc
--- a/components/brave_shields/content/browser/ad_block_subscription_service_manager.cc
+++ b/components/brave_shields/content/browser/ad_block_subscription_service_manager.cc
@@ -42,7 +42,7 @@ base::TimeDelta* g_testing_subscription_retry_interval = nullptr;
 
 constexpr uint16_t kSubscriptionMaxExpiresHours = 14 * 24;
 constexpr base::TimeDelta kListRetryInterval = base::Hours(1);
-constexpr base::TimeDelta kListCheckInitialDelay = base::Minutes(1);
+constexpr base::TimeDelta kListCheckInitialDelay = base::Seconds(3);
 
 bool SkipGURLField(std::string_view value, GURL* field) {
   return true;
@@ -141,6 +141,7 @@ AdBlockSubscriptionServiceManager::AdBlockSubscriptionServiceManager(
       subscription_update_timer_(
           std::make_unique<component_updater::TimerUpdateScheduler>()),
       list_p3a_(list_p3a) {
+  LoadSubscriptionServices();
   std::move(download_manager_getter)
       .Run(base::BindOnce(
           &AdBlockSubscriptionServiceManager::OnGetDownloadManager,
@@ -207,7 +208,7 @@ void AdBlockSubscriptionServiceManager::OnUpdateTimer(
       if (info.enabled &&
           ((info.last_update_attempt != info.last_successful_update_attempt) ||
            (until_next_refresh <= base::TimeDelta()))) {
-        StartDownload(sub_url, false);
+        StartDownload(sub_url, info.last_successful_update_attempt.is_null());
       }
     }
   }
@@ -434,7 +435,7 @@ void AdBlockSubscriptionServiceManager::LoadSubscriptionServices() {
       GURL sub_url(key);
       info = BuildInfoFromDict(sub_url, *list_subscription_dict);
 
-      if (info.enabled) {
+      if (info.enabled && !subscription_filters_providers_.contains(sub_url)) {
         auto subscription_filters_provider =
             std::make_unique<AdBlockSubscriptionFiltersProvider>(
                 filters_provider_manager_,
